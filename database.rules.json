
{
  "rules": {
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chat": {
      ".read": "auth != null",
      "$messageId": {
        ".write": "auth != null && newData.child('u').val() === auth.uid"
      }
    },
    "profiles": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
